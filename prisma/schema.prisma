generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  passwordHash        String
  name                String
  designation         String
  department          String
  activeRole          String              @default("EMPLOYEE")
  avatarUrl           String?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  activityEvents      ActivityEvent[]
  approvedChanges     ChangeRequest[]     @relation("ChangeApprover")
  createdClients      Client[]
  createdDiscussions  ClientDiscussion[]
  clientUpdates       ClientUpdate[]
  docVersions         DocumentVersion[]
  employeeProfile     Employee?
  createdLeads        Lead[]              @relation("CreatedBySalesperson")
  assignedLeads       Lead[]              @relation("AssignedSalesperson")
  leadFollowups       LeadFollowup[]
  notifications       Notification[]
  createdProjects     Project[]           @relation("ProjectCreator")
  completedChecklists ProjectChecklist[]  @relation("ChecklistCompleter")
  assignedChecklists  ProjectChecklist[]  @relation("ChecklistAssignee")
  updatedDocs         ProjectDocument[]   @relation("DocUpdater")
  createdDocs         ProjectDocument[]   @relation("DocCreator")
  removedMemberships  ProjectMembership[] @relation("MembershipRemover")
  assignedMemberships ProjectMembership[] @relation("MembershipAssigner")
  projectNotes        ProjectNote[]
  createdTasks        Task[]              @relation("TaskCreator")
  assignedTasks       Task[]              @relation("TaskAssignee")
  userRoles           UserRole[]
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  code            String           @unique
  description     String?
  rolePermissions RolePermission[]
  userRoles       UserRole[]
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  domain          String
  description     String?
  rolePermissions RolePermission[]
}

model UserRole {
  id     String @id @default(uuid())
  userId String
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Lead {
  id                    String         @id @default(uuid())
  leadNumber            String         @unique
  contactPerson         String
  companyName           String?
  mobile                String
  whatsapp              String?
  email                 String?
  source                String         @default("WEBSITE")
  interestedService     String
  description           String?
  estimatedBudget       Float          @default(0)
  expectedValue         Float          @default(0)
  priority              String         @default("MEDIUM")
  status                String         @default("NEW")
  assignedSalespersonId String?
  nextFollowupAt        DateTime?
  remarks               String?
  lostReason            String?
  createdById           String
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  createdBy             User           @relation("CreatedBySalesperson", fields: [createdById], references: [id])
  assignedSalesperson   User?          @relation("AssignedSalesperson", fields: [assignedSalespersonId], references: [id])
  activities            LeadActivity[]
  followups             LeadFollowup[]

  @@index([assignedSalespersonId])
  @@index([status])
}

model LeadFollowup {
  id                String    @id @default(uuid())
  leadId            String
  salespersonId     String
  scheduledAt       DateTime
  communicationType String    @default("CALL")
  notes             String?
  result            String?
  nextAction        String?
  nextFollowupAt    DateTime?
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())
  salesperson       User      @relation(fields: [salespersonId], references: [id])
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model LeadActivity {
  id          String   @id @default(uuid())
  leadId      String
  actorId     String
  action      String
  detailsJson String?
  createdAt   DateTime @default(now())
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model Client {
  id                 String              @id @default(uuid())
  clientNumber       String              @unique
  companyName        String
  billingAddress     String?
  taxId              String?
  phone              String
  email              String
  notes              String?
  totalBusiness      Float               @default(0)
  outstandingBalance Float               @default(0)
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  createdBy          User                @relation(fields: [createdById], references: [id])
  contacts           ClientContact[]
  portalTokens       ClientPortalToken[]
  invoices           Invoice[]
  projects           Project[]

  @@index([createdById])
}

model ClientContact {
  id          String             @id @default(uuid())
  clientId    String
  name        String
  designation String
  email       String?
  phone       String?
  isPrimary   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  client      Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  discussions ClientDiscussion[]
}

model ProjectType {
  id                  String    @id @default(uuid())
  name                String    @unique
  code                String    @unique
  description         String?
  defaultWorkflowJson String?
  projects            Project[]
}

model Project {
  id                   String              @id @default(uuid())
  projectNumber        String              @unique
  name                 String
  clientId             String
  projectTypeId        String?
  description          String?
  scopeText            String?
  contractValue        Float               @default(0)
  startDate            DateTime?
  targetDeadline       DateTime?
  actualCompletionDate DateTime?
  status               String              @default("DRAFT")
  priority             String              @default("MEDIUM")
  progressPercentage   Float               @default(0)
  liveUrl              String?
  stagingUrl           String?
  designUrl            String?
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  changeRequests       ChangeRequest[]
  discussions          ClientDiscussion[]
  portalTokens         ClientPortalToken[]
  clientUpdates        ClientUpdate[]
  invoices             Invoice[]
  paymentMilestones    PaymentMilestone[]
  createdBy            User                @relation("ProjectCreator", fields: [createdById], references: [id])
  projectType          ProjectType?        @relation(fields: [projectTypeId], references: [id])
  client               Client              @relation(fields: [clientId], references: [id])
  documents            ProjectDocument[]
  memberships          ProjectMembership[]
  notes                ProjectNote[]
  stages               ProjectStage[]
  tasks                Task[]
  workSessions         WorkSession[]

  @@index([clientId])
  @@index([status])
}

model ProjectMembership {
  id            String    @id @default(uuid())
  projectId     String
  employeeId    String
  roleInProject String    @default("MEMBER")
  assignedAt    DateTime  @default(now())
  removedAt     DateTime?
  assignedById  String
  removedById   String?
  removalReason String?
  isActive      Boolean   @default(true)
  removedBy     User?     @relation("MembershipRemover", fields: [removedById], references: [id])
  assignedBy    User      @relation("MembershipAssigner", fields: [assignedById], references: [id])
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectStage {
  id                 String             @id @default(uuid())
  projectId          String
  name               String
  orderIndex         Int                @default(1)
  weight             Float              @default(10)
  progressPercentage Float              @default(0)
  status             String             @default("PENDING")
  createdAt          DateTime           @default(now())
  checklists         ProjectChecklist[]
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks              Task[]
}

model ProjectChecklist {
  id               String       @id @default(uuid())
  stageId          String
  title            String
  description      String?
  status           String       @default("PENDING")
  assignedToId     String?
  startedAt        DateTime?
  completedAt      DateTime?
  completedById    String?
  estimatedMinutes Int          @default(60)
  actualMinutes    Int          @default(0)
  weight           Float        @default(1)
  required         Boolean      @default(true)
  requiresApproval Boolean      @default(false)
  approvedById     String?
  approvedAt       DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  completedBy      User?        @relation("ChecklistCompleter", fields: [completedById], references: [id])
  assignedTo       User?        @relation("ChecklistAssignee", fields: [assignedToId], references: [id])
  stage            ProjectStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model Task {
  id             String        @id @default(uuid())
  projectId      String
  stageId        String?
  title          String
  description    String?
  assignedToId   String?
  createdById    String
  priority       String        @default("MEDIUM")
  status         String        @default("TODO")
  startDate      DateTime?
  deadline       DateTime?
  estimatedHours Float         @default(0)
  actualHours    Float         @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      User          @relation("TaskCreator", fields: [createdById], references: [id])
  assignedTo     User?         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  stage          ProjectStage? @relation(fields: [stageId], references: [id])
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workSessions   WorkSession[]

  @@index([projectId])
  @@index([assignedToId])
  @@index([status])
}

model ProjectDocument {
  id          String            @id @default(uuid())
  projectId   String
  title       String
  category    String            @default("GENERAL")
  content     String
  version     Int               @default(1)
  createdById String
  updatedById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  versions    DocumentVersion[]
  updatedBy   User              @relation("DocUpdater", fields: [updatedById], references: [id])
  createdBy   User              @relation("DocCreator", fields: [createdById], references: [id])
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DocumentVersion {
  id           String          @id @default(uuid())
  documentId   String
  version      Int
  content      String
  changeReason String?
  updatedById  String
  createdAt    DateTime        @default(now())
  updatedBy    User            @relation(fields: [updatedById], references: [id])
  document     ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model ProjectNote {
  id         String   @id @default(uuid())
  projectId  String
  authorId   String
  content    String
  visibility String   @default("INTERNAL")
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ClientDiscussion {
  id              String         @id @default(uuid())
  projectId       String
  clientContactId String?
  date            DateTime       @default(now())
  startTime       String?
  endTime         String?
  summary         String
  discussionText  String
  decisionsText   String?
  actionItemsText String?
  createdById     String
  createdAt       DateTime       @default(now())
  createdBy       User           @relation(fields: [createdById], references: [id])
  clientContact   ClientContact? @relation(fields: [clientContactId], references: [id])
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ChangeRequest {
  id                  String    @id @default(uuid())
  requestNumber       String    @unique
  projectId           String
  requestedBy         String
  source              String    @default("CLIENT")
  originalRequirement String
  requestedChange     String
  reason              String?
  technicalImpact     String?
  timelineImpactDays  Int       @default(0)
  costImpactAmount    Float     @default(0)
  estimatedHours      Float     @default(0)
  status              String    @default("DRAFT")
  approvedById        String?
  approvedAt          DateTime?
  createdAt           DateTime  @default(now())
  approvedBy          User?     @relation("ChangeApprover", fields: [approvedById], references: [id])
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Employee {
  id                 String                @id @default(uuid())
  userId             String                @unique
  employeeIdCode     String                @unique
  joiningDate        DateTime              @default(now())
  status             String                @default("ACTIVE")
  salaryMonthly      Float                 @default(0)
  reportingManagerId String?
  skillsJson         String?               @default("[]")
  createdAt          DateTime              @default(now())
  attendances        Attendance[]
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  statusEvents       EmployeeStatusEvent[]
  memberships        ProjectMembership[]
  workSessions       WorkSession[]
}

model Attendance {
  id                    String    @id @default(uuid())
  employeeId            String
  date                  DateTime  @default(now())
  punchIn               DateTime
  punchOut              DateTime?
  status                String    @default("PRESENT")
  totalMinutes          Int?      @default(0)
  punchOutReason        String?
  punchOutRequestStatus String?
  punchOutRequestedAt   DateTime?
  punchOutApprovedById  String?
  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, date])
}

model EmployeeStatusEvent {
  id         String    @id @default(uuid())
  employeeId String
  statusType String    @default("WORKING")
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  notes      String?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model WorkSession {
  id              String    @id @default(uuid())
  employeeId      String
  projectId       String?
  taskId          String?
  statusType      String    @default("WORKING")
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationMinutes Int       @default(0)
  notes           String?
  task            Task?     @relation(fields: [taskId], references: [id])
  project         Project?  @relation(fields: [projectId], references: [id])
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model PaymentMilestone {
  id                   String    @id @default(uuid())
  projectId            String
  title                String
  amount               Float
  dueDate              DateTime
  status               String    @default("UPCOMING")
  paidAmount           Float     @default(0)
  paidAt               DateTime?
  paymentMethod        String?
  transactionReference String?
  invoiceNumber        String?
  notes                String?
  createdAt            DateTime  @default(now())
  project              Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  projectId     String
  clientId      String
  issueDate     DateTime @default(now())
  dueDate       DateTime
  totalAmount   Float
  taxAmount     Float    @default(0)
  grandTotal    Float
  status        String   @default("UNPAID")
  itemsJson     String   @default("[]")
  createdAt     DateTime @default(now())
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model ClientPortalToken {
  id        String   @id @default(uuid())
  clientId  String
  projectId String
  token     String   @unique
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model ClientUpdate {
  id         String   @id @default(uuid())
  projectId  String
  title      String
  content    String
  visibility String   @default("CLIENT_VISIBLE")
  authorId   String
  createdAt  DateTime @default(now())
  author     User     @relation(fields: [authorId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ActivityEvent {
  id           String   @id @default(uuid())
  eventType    String
  actorId      String
  entityType   String
  entityId     String
  projectId    String?
  clientId     String?
  metadataJson String?
  createdAt    DateTime @default(now())
  actor        User     @relation(fields: [actorId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  recipientId String
  title       String
  message     String
  urgency     String   @default("MEDIUM")
  linkUrl     String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
}
