# .env.example
# REQUIRED FOR PRODUCTION
# Do not commit real secrets here. Use this file as a template for your deployment environment.

# NextAuth Configuration
# Must be set to a strong random string in production (e.g., generated with `openssl rand -base64 32`)
NEXTAUTH_SECRET=
NEXTAUTH_URL="http://your-production-domain.com/ess-os"

# Server Configuration
PORT=3040
NODE_ENV=production

# Database Configuration (handled via Docker volumes)
# If using external DB, set here
# DATABASE_URL=

# Cron job secret — set this to a strong random string in production
# The auto-punch-out endpoint at /api/cron/auto-punch-out requires:
# Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
